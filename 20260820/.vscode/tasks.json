{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build active cpp file",
            "type": "shell",
            "command": "D:\\ProgramFiles\\Dev-Cpp\\MinGW64\\bin\\g++.exe",
            "args": [
                "-g",
                "${file}",
                "-o",
                "D:\\debug_bin\\${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 生成活动文件",
            "command": "D:\\ProgramFiles\\Dev-Cpp\\MinGW64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "D:\\debug_bin\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "D:\\ProgramFiles\\Dev-Cpp\\MinGW64\\bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        },
        {
            "label": "Run active cpp file (Dev-Cpp style)",
            "type": "shell",
            "dependsOn": "Build active cpp file",
            "command": "cmd.exe",
            "args": [
                "/c",
                "start",
                "\"\"",
                "cmd",
                "/k",
                "D:\\debug_bin\\${fileBasenameNoExtension}.exe & pause"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}